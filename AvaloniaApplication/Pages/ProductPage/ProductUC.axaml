
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Domain.Models"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="AvaloniaApplication.Pages.ProductPage.ProductUC">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="20"
                    Margin="10,10,10,0"
                    VerticalAlignment="Center">

            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Products.Count,
                                      StringFormat='Всего товаров: {0}'}" />

            <TextBlock VerticalAlignment="Center"
                       Text="{Binding BoughtCount,
                                      StringFormat='Куплено: {0}'}" />

            <Button Content="Очистить купленные"
                    Command="{Binding ClearBoughtCommand}" />

        </StackPanel>

        <DataGrid Grid.Row="1"
                  x:Name="ItemsGrid"
                  Margin="10"
                  ItemsSource="{Binding VisibleProducts}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60" />

                <DataGridTemplateColumn Header="Наименование"
                                        Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <CheckBox IsChecked="{Binding IsBought}"
                                      Content="{Binding Name}"
                                      Margin="8,0"
                                      Click="OnBoughtClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Действия"
                                        Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <UniformGrid Columns="2">
                                <Button Content="Добавить в список"
                                        Click="AddToList_Click" />
                                <Button Content="Удалить"
                                        Click="RemoveFromList_Click" />
                            </UniformGrid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
