<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication.Pages.Header"
             Background="#FFD166">
    <StackPanel Orientation="Horizontal" Spacing="30" Margin="20">
        <TextBox x:Name="ProductNameInput" 
                 Width="250" 
                 Height="60"
                 Watermark="Название товара..." />
        <Button x:Name="AddButton" Click="OnAddClick" Content="Добавить новый товар" Foreground="Black"/>
        <Button x:Name="GetButton" Click="GetButton_OnClick" Content="Список покупок" Foreground="Black"/>
    </StackPanel>
</UserControl>
